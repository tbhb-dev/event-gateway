"""Root workspace for building and testing event-gateway."""

module(name = "event_gateway_dev")

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")

# A Go repository registers the hermetic C/C++ toolchain itself:
# hermetic_cc_toolchain makes its repositories only for the root module.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
)

# Shared lint, format and test rules, with default tool pins. Not on the BCR
# yet, so it comes from Git, pinned to a commit on the rules repository's main
# branch. Every tbhb_rules* module moves together. Local development
# points at a clone instead, with
# `common --override_module=tbhb_rules=../rules` in .bazelrc.user.
bazel_dep(name = "tbhb_rules", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "tbhb_rules",
    commit = "5f66bbd282e07b5ea1b9bbb51464dee92c3cc2c9",
    remote = "https://github.com/tbhb-dev/rules.git",
)

# The Go checks (golangci-lint, deadcode, go-arch-lint, go mod tidy and the
# golangci-lint formatter), a nested module of the same repository. Same pin
# as tbhb_rules; locally,
# `common --override_module=tbhb_rules_go=../rules/go`.
bazel_dep(name = "tbhb_rules_go", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "tbhb_rules_go",
    commit = "5f66bbd282e07b5ea1b9bbb51464dee92c3cc2c9",
    remote = "https://github.com/tbhb-dev/rules.git",
    strip_prefix = "go",
)

# Dev dependencies: tooling that only this workspace needs.
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "bazelrc-preset.bzl", version = "1.10.0", dev_dependency = True)

# The OS constraints for bazel_env.
bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)

# Stable paths and PATH shims (.bazel_env/bin) for the Bazel-pinned tools,
# which git hooks and editors call without starting Bazel.
bazel_dep(name = "bazel_env.bzl", version = "0.10.0", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# Vet-class analyzers run during the build, for this repository's packages
# only. golangci-lint stays the full linter (//:golangci_lint_test).
go_sdk.nogo(
    includes = ["//:__subpackages__"],
    nogo = "//:nogo",
)

# Tool binaries: tbhb_rules' pins, one hub repository per tool. This module
# refers to the same labels for its own targets and its bazel_env shims, so
# each tool has one pin; override_repo swaps one if needed.
tools = use_extension("@tbhb_rules//pins:extensions.bzl", "tools")
use_repo(
    tools,
    "tbhb_rules_actionlint",
    "tbhb_rules_cog",
    "tbhb_rules_editorconfig_checker",
    "tbhb_rules_git",
    "tbhb_rules_rumdl",
    "tbhb_rules_ryl",
    "tbhb_rules_shellcheck",
    "tbhb_rules_shfmt",
    "tbhb_rules_tombi",
    "tbhb_rules_vale",
    "tbhb_rules_zizmor",
)

runtime = use_extension("@tbhb_rules//runtime:extensions.bzl", "runtime", dev_dependency = True)
use_repo(runtime, "tbhb_rules_python_runtime")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_coder_websocket",
    "com_github_go_logr_logr",
    "com_github_modelcontextprotocol_go_sdk",
    "com_github_nats_io_nats_go",
    "com_github_nats_io_nats_server_v2",
    "io_opentelemetry_go_contrib_bridges_otelslog",
    "io_opentelemetry_go_otel",
    "io_opentelemetry_go_otel_exporters_otlp_otlptrace",
    "io_opentelemetry_go_otel_metric",
    "io_opentelemetry_go_otel_sdk",
    "io_opentelemetry_go_otel_sdk_log",
    "io_opentelemetry_go_otel_sdk_metric",
    "io_opentelemetry_go_otel_trace",
    "io_opentelemetry_go_proto_otlp",
    "io_temporal_go_api",
    "io_temporal_go_sdk",
    "org_golang_google_protobuf",
)

go_mod_proxy = use_extension("@tbhb_rules_go//:extensions.bzl", "go_mod_proxy")
go_mod_proxy.from_file(
    name = "go_mod_proxy",
    go_sum = "//:go.sum",
)
use_repo(go_mod_proxy, "go_mod_proxy")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Temporal CLI v1.10.1 archives follow this URL pattern (Windows uses .zip).
# https://github.com/temporalio/cli/releases/download/v1.10.1/temporal_cli_1.10.1_<os>_<arch>.tar.gz
# Pins come from the release's own checksum file.
# https://github.com/temporalio/cli/releases/download/v1.10.1/checksums.txt
http_archive(
    name = "temporal_linux_amd64",
    build_file_content = 'exports_files(["temporal"])',
    dev_dependency = True,
    sha256 = "4c1500e2ce2d4de136e5fe8852d9b7f82eb62f19b6b383b3e0c040519a9d20b1",
    urls = ["https://github.com/temporalio/cli/releases/download/v1.10.1/temporal_cli_1.10.1_linux_amd64.tar.gz"],
)

http_archive(
    name = "temporal_linux_arm64",
    build_file_content = 'exports_files(["temporal"])',
    dev_dependency = True,
    sha256 = "2f748e9411b37c9cabb57f1f08e37765388c12b5534432c7aea28b593df9145d",
    urls = ["https://github.com/temporalio/cli/releases/download/v1.10.1/temporal_cli_1.10.1_linux_arm64.tar.gz"],
)

http_archive(
    name = "temporal_darwin_amd64",
    build_file_content = 'exports_files(["temporal"])',
    dev_dependency = True,
    sha256 = "8ec6c513ad2177de4eb15d2cb17a4fe5070e6078afd7f80bdfcc37fae459d3c4",
    urls = ["https://github.com/temporalio/cli/releases/download/v1.10.1/temporal_cli_1.10.1_darwin_amd64.tar.gz"],
)

http_archive(
    name = "temporal_darwin_arm64",
    build_file_content = 'exports_files(["temporal"])',
    dev_dependency = True,
    sha256 = "94f7f982b26438e8abbde6000ba471b694be6a2413b31f6162f87a9f9c48c738",
    urls = ["https://github.com/temporalio/cli/releases/download/v1.10.1/temporal_cli_1.10.1_darwin_arm64.tar.gz"],
)

http_archive(
    name = "temporal_windows_amd64",
    build_file_content = 'exports_files(["temporal.exe"])',
    dev_dependency = True,
    sha256 = "5069cdb76569914305ed7c90e1c8406cd27bcb6c2a822fce201a488c34ab074f",
    urls = ["https://github.com/temporalio/cli/releases/download/v1.10.1/temporal_cli_1.10.1_windows_amd64.zip"],
)

# Vale style packages, one per `Packages` URL in .vale.ini and in the same
# order, pinned by digest. //:vale_test syncs from these instead of the
# network. Move a version here and in .vale.ini together.
http_file(
    name = "vale_google",
    dev_dependency = True,
    downloaded_file_path = "Google.zip",
    sha256 = "c1f61ae1c4cee3f2c2ffb2912fbbdff48a02c0e47e114dfd6435b15438171d97",
    url = "https://github.com/errata-ai/Google/releases/download/v0.7.2/Google.zip",
)

http_file(
    name = "vale_write_good",
    dev_dependency = True,
    downloaded_file_path = "write-good.zip",
    sha256 = "2960ef10861ddc7dc76292a4967eb3789bf05ca24f862042f6d15f53332887f0",
    url = "https://github.com/errata-ai/write-good/releases/download/v0.4.1/write-good.zip",
)

http_file(
    name = "vale_proselint",
