load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "event-gateway_lib",
    srcs = [
        "github.go",
        "main.go",
        "store.go",
        "telemetry.go",
    ],
    importpath = "go.tbhb.dev/event-gateway/cmd/event-gateway",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_nats_io_nats_go//:nats_go",
        "@com_github_nats_io_nats_go//jetstream",
        "@com_github_nats_io_nats_server_v2//server",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_metric//:metric",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_binary(
    name = "event-gateway",
    embed = [":event-gateway_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "event-gateway_test",
    srcs = [
        "github_internal_test.go",
        "main_internal_test.go",
        "store_internal_test.go",
    ],
    embed = [":event-gateway_lib"],
    # The whole-module Go checks in the root package take the tests too.
    visibility = ["//:__pkg__"],
    deps = [
        "@com_github_nats_io_nats_go//:nats_go",
        "@com_github_nats_io_nats_go//jetstream",
        "@com_github_nats_io_nats_server_v2//server",
        "@io_opentelemetry_go_otel_metric//noop",
        "@io_opentelemetry_go_otel_sdk//trace",
        "@io_opentelemetry_go_otel_sdk//trace/tracetest",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
        "@io_opentelemetry_go_otel_trace//noop",
    ],
)
