load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "event-gateway_lib",
    srcs = [
        "github.go",
        "grafana.go",
        "healthcheck.go",
        "main.go",
        "otlp.go",
        "read.go",
        "read_tokens.go",
        "runner.go",
        "serve.go",
        "session.go",
        "store.go",
        "telemetry.go",
    ],
    importpath = "go.tbhb.dev/event-gateway/cmd/event-gateway",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/filter",
        "@com_github_coder_websocket//:websocket",
        "@com_github_go_logr_logr//:logr",
        "@com_github_nats_io_nats_go//:nats_go",
        "@com_github_nats_io_nats_go//jetstream",
        "@com_github_nats_io_nats_server_v2//server",
        "@io_opentelemetry_go_contrib_bridges_otelslog//:otelslog",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_exporters_otlp_otlptrace//:otlptrace",
        "@io_opentelemetry_go_otel_metric//:metric",
        "@io_opentelemetry_go_otel_metric//noop",
        "@io_opentelemetry_go_otel_sdk//resource",
        "@io_opentelemetry_go_otel_sdk//trace",
        "@io_opentelemetry_go_otel_sdk_log//:log",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//exemplar",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
        "@io_opentelemetry_go_otel_trace//:trace",
        "@io_opentelemetry_go_otel_trace//noop",
        "@io_opentelemetry_go_proto_otlp//collector/logs/v1:logs",
        "@io_opentelemetry_go_proto_otlp//collector/metrics/v1:metrics",
        "@io_opentelemetry_go_proto_otlp//collector/trace/v1:trace",
        "@io_opentelemetry_go_proto_otlp//common/v1:common",
        "@io_opentelemetry_go_proto_otlp//logs/v1:logs",
        "@io_opentelemetry_go_proto_otlp//metrics/v1:metrics",
        "@io_opentelemetry_go_proto_otlp//resource/v1:resource",
        "@io_opentelemetry_go_proto_otlp//trace/v1:trace",
        "@org_golang_google_protobuf//proto",
    ],
)

go_binary(
    name = "event-gateway",
    embed = [":event-gateway_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "event-gateway_test",
    srcs = [
        "github_internal_test.go",
        "grafana_internal_test.go",
        "healthcheck_internal_test.go",
        "main_internal_test.go",
        "otlp_internal_test.go",
        "read_internal_test.go",
        "runner_internal_test.go",
        "session_internal_test.go",
        "store_internal_test.go",
    ],
    embed = [":event-gateway_lib"],
    # The whole-module Go checks in the root package take the tests too.
    visibility = ["//:__pkg__"],
    deps = [
        "@com_github_coder_websocket//:websocket",
        "@com_github_go_logr_logr//funcr",
        "@com_github_nats_io_nats_go//:nats_go",
        "@com_github_nats_io_nats_go//jetstream",
        "@com_github_nats_io_nats_server_v2//server",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel_metric//noop",
        "@io_opentelemetry_go_otel_sdk//trace",
        "@io_opentelemetry_go_otel_sdk//trace/tracetest",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
        "@io_opentelemetry_go_otel_trace//noop",
        "@io_opentelemetry_go_proto_otlp//collector/metrics/v1:metrics",
        "@io_opentelemetry_go_proto_otlp//collector/trace/v1:trace",
        "@org_golang_google_protobuf//proto",
    ],
)
