load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("@tbhb_rules_go//:defs.bzl", "gobco_test")

repo_files()

gobco_test(
    name = "temporaltarget_gobco_test",
    go_mod = "//:go.mod",
    go_sum = "//:go.sum",
    proxy = "@go_mod_proxy//:proxy",
    tests = [":temporaltarget_test"],
)

go_library(
    name = "temporaltarget",
    srcs = [
        "connection.go",
        "sdk.go",
        "target.go",
    ],
    importpath = "go.tbhb.dev/event-gateway/internal/temporaltarget",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/eventfields",
        "//internal/routing",
        "@io_temporal_go_api//common/v1:common",
        "@io_temporal_go_api//enums/v1:enums",
        "@io_temporal_go_api//serviceerror",
        "@io_temporal_go_sdk//client",
        "@io_temporal_go_sdk//converter",
        "@io_temporal_go_sdk//temporal",
    ],
)

go_test(
    name = "temporaltarget_test",
    srcs = [
        "connection_internal_test.go",
        "sdk_internal_test.go",
        "target_internal_test.go",
    ],
    embed = [":temporaltarget"],
    visibility = ["//:__pkg__"],
    deps = [
        "//internal/eventfields",
        "//internal/routing",
        "@io_temporal_go_api//common/v1:common",
        "@io_temporal_go_api//enums/v1:enums",
        "@io_temporal_go_api//serviceerror",
        "@io_temporal_go_sdk//client",
        "@io_temporal_go_sdk//converter",
        "@io_temporal_go_sdk//temporal",
    ],
