load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "routing",
    srcs = ["routing.go"],
    importpath = "go.tbhb.dev/event-gateway/internal/routing",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/filter"],
)

go_test(
    name = "routing_test",
    srcs = ["routing_test.go"],
    visibility = ["//:__pkg__"],
    deps = [
        ":routing",
        "//internal/filter",
    ],
)
